FROM node:22-slim AS node
FROM labradour-acceptance
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm tmux fonts-dejavu-core \
    && npm install -g @anthropic-ai/claude-code@2.1.234 @openai/codex@0.160.0 \
    && rm -rf /var/lib/apt/lists/*
